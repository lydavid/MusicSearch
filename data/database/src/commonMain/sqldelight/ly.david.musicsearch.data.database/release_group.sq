import kotlin.String;
import kotlin.collections.List;

CREATE TABLE release_group (
  id TEXT PRIMARY KEY NOT NULL,
  name TEXT NOT NULL,
  disambiguation TEXT NOT NULL,
  first_release_date TEXT NOT NULL,
  primary_type TEXT NOT NULL,
  primary_type_id TEXT NOT NULL,
  secondary_types TEXT AS List<String> NOT NULL,
  secondary_type_ids TEXT AS List<String> NOT NULL
);

-- queries

upsert {
UPDATE release_group
SET
  name = :name,
  disambiguation = :disambiguation,
  first_release_date = :first_release_date,
  primary_type = :primary_type,
  primary_type_id = :primary_type_id,
  secondary_types = :secondary_types,
  secondary_type_ids = :secondary_type_ids
WHERE id = :id;

INSERT OR IGNORE INTO release_group
VALUES (
  :id,
  :name,
  :disambiguation,
  :first_release_date,
  :primary_type,
  :primary_type_id,
  :secondary_types,
  :secondary_type_ids
);
}

getReleaseGroupForDetails:
WITH
  rec_listens AS (
    SELECT
      recording_musicbrainz_id AS recording_id,
      COUNT(*) AS listen_count,
      MAX(listened_at_ms) AS last_listened_at
    FROM listen
    WHERE username = :listenBrainzUsername
      AND deleted_at_ms IS NULL
    GROUP BY recording_musicbrainz_id
  ),
  rg_stats AS (
    SELECT
      uniq.release_group_id,
      COALESCE(SUM(rec_listens.listen_count), 0) AS listen_count,
      MAX(rec_listens.last_listened_at) AS last_listened_at
    FROM (
      SELECT DISTINCT
        release_release_group.release_group_id AS release_group_id,
        track.recording_id AS recording_id
      FROM release_release_group
      INNER JOIN release ON release_release_group.release_id = release.id
      INNER JOIN medium ON medium.release_id = release.id
      INNER JOIN track ON track.medium_id = medium.id
    ) AS uniq
    LEFT JOIN rec_listens ON rec_listens.recording_id = uniq.recording_id
    GROUP BY uniq.release_group_id
  )
SELECT
  rg.id,
  rg.name,
  rg.disambiguation,
  rg.first_release_date,
  rg.primary_type_id,
  rg.secondary_type_ids,
  details_metadata.last_updated,
  CASE WHEN :listenBrainzUsername = '' THEN CAST(NULL AS INTEGER) ELSE COALESCE(lg.listen_count, 0) END AS listen_count
FROM release_group rg
LEFT JOIN details_metadata ON details_metadata.entity_id = rg.id
LEFT JOIN rg_stats lg ON lg.release_group_id = rg.id
WHERE rg.id = :releaseGroupId;

getReleaseGroupForRelease:
SELECT
  rg.id,
  rg.name,
  rg.disambiguation,
  rg.first_release_date,
  rg.primary_type_id,
  rg.secondary_type_ids
FROM release_group rg
INNER JOIN release_release_group rrg ON rg.id = rrg.release_group_id
INNER JOIN release r ON rrg.release_id = r.id
WHERE r.id = :releaseId
LIMIT 1;

-- listens

getListenCountByReleaseGroup:
SELECT COUNT(*)
FROM (
  SELECT DISTINCT track.recording_id
  FROM release_release_group
  INNER JOIN release ON release_release_group.release_id = release.id
  INNER JOIN medium ON medium.release_id = release.id
  INNER JOIN track ON track.medium_id = medium.id
) AS recs
INNER JOIN listen ON listen.recording_musicbrainz_id = recs.recording_id
  AND listen.username = :username
  AND listen.deleted_at_ms IS NULL;

getLatestListensByReleaseGroup:
SELECT
  recording.id,
  recording.name,
  recording.disambiguation,
  listen.listened_at_ms
FROM (
  SELECT DISTINCT track.recording_id
  FROM release_release_group
  INNER JOIN release ON release_release_group.release_id = release.id
  INNER JOIN medium ON medium.release_id = release.id
  INNER JOIN track ON track.medium_id = medium.id
  WHERE release_release_group.release_group_id = :releaseGroupId
) AS recs
INNER JOIN recording ON recording.id = recs.recording_id
INNER JOIN listen ON listen.recording_musicbrainz_id = recording.id
  AND listen.username = :username
  AND listen.deleted_at_ms IS NULL
ORDER BY listened_at_ms DESC
LIMIT COALESCE(:limit, -1);

deleteReleaseGroup:
DELETE FROM release_group
WHERE id = :id;

-- release groups by entity

CREATE TABLE IF NOT EXISTS release_groups_by_entity (
  entity_id TEXT NOT NULL,
  release_group_id TEXT NOT NULL,

  PRIMARY KEY(entity_id, release_group_id)
);

insertOrIgnoreReleaseGroupByEntity:
INSERT OR IGNORE INTO release_groups_by_entity
VALUES ?;

deleteReleaseGroupLinksByEntity {
DELETE FROM release_groups_by_entity WHERE entity_id = :entityId;
}

getCountOfEachAlbumTypes:
SELECT
  rg.primary_type_id,
  rg.secondary_type_ids,
  COUNT(rg.id) AS count
FROM release_group rg
GROUP BY rg.primary_type_id, rg.secondary_type_ids
ORDER BY rg.primary_type, rg.secondary_types;

getCountOfEachAlbumTypesByEntity:
SELECT
  rg.primary_type_id,
  rg.secondary_type_ids,
  COUNT(rg.id) AS count
FROM release_group rg
INNER JOIN release_groups_by_entity ON rg.id = release_groups_by_entity.release_group_id
WHERE release_groups_by_entity.entity_id = :entityId
GROUP BY rg.primary_type_id, rg.secondary_type_ids
ORDER BY rg.primary_type, rg.secondary_types;

getCountOfEachAlbumTypesByCollection:
SELECT
  rg.primary_type_id,
  rg.secondary_type_ids,
  COUNT(rg.id) AS count
FROM release_group rg
INNER JOIN collection_entity ON rg.id = collection_entity.entity_id
WHERE collection_entity.id = :collectionId
GROUP BY rg.primary_type_id, rg.secondary_type_ids
ORDER BY rg.primary_type, rg.secondary_types;

getCountOfReleaseGroupsByEntity:
SELECT IFNULL(
  COUNT(DISTINCT release_group.id),
  0
) AS count
FROM release_group
INNER JOIN release_groups_by_entity ON release_group.id = release_groups_by_entity.release_group_id
INNER JOIN artist_credit_entity acr ON acr.entity_id = release_group.id
INNER JOIN artist_credit ac ON ac.id = acr.artist_credit_id
LEFT JOIN release_group_alias ON release_group.id = release_group_alias.release_group_id AND release_group_alias.is_primary
WHERE release_groups_by_entity.entity_id = :entityId
AND (
  release_group.name LIKE :query OR
  release_group.disambiguation LIKE :query OR
  release_group.first_release_date LIKE :query OR
  release_group.primary_type LIKE :query OR
  release_group.secondary_types LIKE :query OR
  ac.name LIKE :query OR
  release_group_alias.name LIKE :query
);

getReleaseGroupsByEntity:
WITH
  rec_listens AS (
    SELECT
      recording_musicbrainz_id AS recording_id,
      COUNT(*) AS listen_count,
      MAX(listened_at_ms) AS last_listened_at
    FROM listen
    WHERE username = :username
      AND deleted_at_ms IS NULL
    GROUP BY recording_musicbrainz_id
  ),
  rg_stats AS (
    SELECT
      uniq.release_group_id,
      COALESCE(SUM(rec_listens.listen_count), 0) AS listen_count,
      MAX(rec_listens.last_listened_at) AS last_listened_at
    FROM (
      SELECT DISTINCT
        release_release_group.release_group_id AS release_group_id,
        track.recording_id AS recording_id
      FROM release_release_group
      INNER JOIN release ON release_release_group.release_id = release.id
      INNER JOIN medium ON medium.release_id = release.id
      INNER JOIN track ON track.medium_id = medium.id
    ) AS uniq
    LEFT JOIN rec_listens ON rec_listens.recording_id = uniq.recording_id
    GROUP BY uniq.release_group_id
  )
SELECT
  release_group.id,
  release_group.name,
  release_group.disambiguation,
  release_group.first_release_date,
  release_group.primary_type_id,
  release_group.secondary_type_ids,
  ac.name AS artist_credits,
  images.id AS image_id,
  images.source,
  images.thumbnail_url,
  EXISTS (
    SELECT 1 FROM details_metadata WHERE details_metadata.entity_id = release_group.id
  ) AS visited,
  EXISTS (
    SELECT 1 FROM collection_entity WHERE collection_entity.entity_id = release_group.id
  ) AS collected,
  aliases.alias_names,
  aliases.alias_locales,
  CASE WHEN :username = '' THEN CAST(NULL AS INTEGER) ELSE COALESCE(lg.listen_count, 0) END AS listen_count,
  CASE WHEN :username = '' THEN CAST(NULL AS INTEGER) ELSE lg.last_listened_at END AS last_listened_at
FROM release_group
INNER JOIN release_groups_by_entity ON release_group.id = release_groups_by_entity.release_group_id
INNER JOIN artist_credit_entity acr ON acr.entity_id = release_group.id
INNER JOIN artist_credit ac ON ac.id = acr.artist_credit_id
LEFT JOIN rg_stats lg ON lg.release_group_id = release_group.id
LEFT JOIN mbid_image images ON images.mbid = release_group.id
LEFT JOIN (
  SELECT
    release_group_alias.release_group_id,
    GROUP_CONCAT(release_group_alias.name, CHAR(9)) AS alias_names,
    GROUP_CONCAT(release_group_alias.locale, CHAR(9)) AS alias_locales
  FROM release_group_alias
  WHERE release_group_alias.is_primary AND release_group_alias.release_group_id IN (
    SELECT release_group.id
    FROM release_group
    INNER JOIN release_groups_by_entity ON release_group.id = release_groups_by_entity.release_group_id
    WHERE release_groups_by_entity.entity_id = :entityId
  )
  GROUP BY release_group_alias.release_group_id
) AS aliases ON aliases.release_group_id = release_group.id
WHERE release_groups_by_entity.entity_id = :entityId
AND (
  release_group.name LIKE :query OR
  release_group.disambiguation LIKE :query OR
  release_group.first_release_date LIKE :query OR
  release_group.primary_type LIKE :query OR
  release_group.secondary_types LIKE :query OR
  artist_credits LIKE :query OR
  aliases.alias_names LIKE :query
)
GROUP BY release_group.id
ORDER BY
  CASE :sortBy
    WHEN 0 THEN release_groups_by_entity.rowid
    WHEN 2 THEN release_group.name
    WHEN 4 THEN release_group.first_release_date
    WHEN 6 THEN release_group.primary_type
    WHEN 8 THEN listen_count
    WHEN 10 THEN last_listened_at
  END ASC,
  CASE :sortBy
    WHEN 1 THEN release_groups_by_entity.rowid
    WHEN 3 THEN release_group.name
    WHEN 5 THEN release_group.first_release_date
    WHEN 7 THEN release_group.primary_type
    WHEN 9 THEN listen_count
    WHEN 11 THEN last_listened_at
  END DESC,
  release_group.primary_type ASC,
  release_group.secondary_types ASC,
  release_group.first_release_date ASC
LIMIT :limit OFFSET :offset;

-- release groups by collection

getCountOfReleaseGroupsByCollection:
SELECT IFNULL(
  COUNT(DISTINCT release_group.id),
  0
) AS count
FROM release_group
INNER JOIN collection_entity ON release_group.id = collection_entity.entity_id
INNER JOIN artist_credit_entity acr ON acr.entity_id = release_group.id
INNER JOIN artist_credit ac ON ac.id = acr.artist_credit_id
LEFT JOIN release_group_alias ON release_group.id = release_group_alias.release_group_id AND release_group_alias.is_primary
WHERE collection_entity.id = :collectionId
AND collection_entity.deleted = 0
AND (
  release_group.name LIKE :query OR
  release_group.disambiguation LIKE :query OR
  release_group.first_release_date LIKE :query OR
  release_group.primary_type LIKE :query OR
  release_group.secondary_types LIKE :query OR
  ac.name LIKE :query OR
  release_group_alias.name LIKE :query
);

getReleaseGroupsByCollection:
WITH
  rec_listens AS (
    SELECT
      recording_musicbrainz_id AS recording_id,
      COUNT(*) AS listen_count,
      MAX(listened_at_ms) AS last_listened_at
    FROM listen
    WHERE username = :username
      AND deleted_at_ms IS NULL
    GROUP BY recording_musicbrainz_id
  ),
  rg_stats AS (
    SELECT
      uniq.release_group_id,
      COALESCE(SUM(rec_listens.listen_count), 0) AS listen_count,
      MAX(rec_listens.last_listened_at) AS last_listened_at
    FROM (
      SELECT DISTINCT
        release_release_group.release_group_id AS release_group_id,
        track.recording_id AS recording_id
      FROM release_release_group
      INNER JOIN release ON release_release_group.release_id = release.id
      INNER JOIN medium ON medium.release_id = release.id
      INNER JOIN track ON track.medium_id = medium.id
    ) AS uniq
    LEFT JOIN rec_listens ON rec_listens.recording_id = uniq.recording_id
    GROUP BY uniq.release_group_id
  )
SELECT
  release_group.id,
  release_group.name,
  release_group.disambiguation,
  release_group.first_release_date,
  release_group.primary_type_id,
  release_group.secondary_type_ids,
  ac.name AS artist_credits,
  images.id AS image_id,
  images.source,
  images.thumbnail_url,
  EXISTS (
    SELECT 1 FROM details_metadata WHERE details_metadata.entity_id = release_group.id
  ) AS visited,
  EXISTS (
    SELECT 1 FROM collection_entity WHERE collection_entity.entity_id = release_group.id
  ) AS collected,
  aliases.alias_names,
  aliases.alias_locales,
  CASE WHEN :username = '' THEN CAST(NULL AS INTEGER) ELSE COALESCE(lg.listen_count, 0) END AS listen_count,
  CASE WHEN :username = '' THEN CAST(NULL AS INTEGER) ELSE lg.last_listened_at END AS last_listened_at
FROM release_group
INNER JOIN collection_entity ON release_group.id = collection_entity.entity_id
INNER JOIN artist_credit_entity acr ON acr.entity_id = release_group.id
INNER JOIN artist_credit ac ON ac.id = acr.artist_credit_id
LEFT JOIN rg_stats lg ON lg.release_group_id = release_group.id
LEFT JOIN mbid_image images ON images.mbid = release_group.id
LEFT JOIN (
  SELECT
    release_group_alias.release_group_id,
    GROUP_CONCAT(release_group_alias.name, CHAR(9)) AS alias_names,
    GROUP_CONCAT(release_group_alias.locale, CHAR(9)) AS alias_locales
  FROM release_group_alias
  WHERE release_group_alias.is_primary AND release_group_alias.release_group_id IN (
    SELECT release_group.id
    FROM release_group
    INNER JOIN collection_entity ON release_group.id = collection_entity.entity_id
    WHERE collection_entity.id = :collectionId
  )
  GROUP BY release_group_alias.release_group_id
) AS aliases ON aliases.release_group_id = release_group.id
WHERE collection_entity.id = :collectionId
AND collection_entity.deleted = 0
AND (
  release_group.name LIKE :query OR
  release_group.disambiguation LIKE :query OR
  release_group.first_release_date LIKE :query OR
  release_group.primary_type LIKE :query OR
  release_group.secondary_types LIKE :query OR
  artist_credits LIKE :query OR
  aliases.alias_names LIKE :query
)
GROUP BY release_group.id
ORDER BY
  CASE :sortBy
    WHEN 0 THEN collection_entity.rowid
    WHEN 2 THEN release_group.name
    WHEN 4 THEN release_group.first_release_date
    WHEN 6 THEN release_group.primary_type
    WHEN 8 THEN listen_count
    WHEN 10 THEN last_listened_at
  END ASC,
  CASE :sortBy
    WHEN 1 THEN collection_entity.rowid
    WHEN 3 THEN release_group.name
    WHEN 5 THEN release_group.first_release_date
    WHEN 7 THEN release_group.primary_type
    WHEN 9 THEN listen_count
    WHEN 11 THEN last_listened_at
  END DESC,
  release_group.primary_type ASC,
  release_group.secondary_types ASC,
  release_group.first_release_date ASC
LIMIT :limit OFFSET :offset;

-- all release groups

getCountOfAllReleaseGroups:
SELECT COUNT(release_group.id) AS count
FROM release_group
INNER JOIN artist_credit_entity acr ON acr.entity_id = release_group.id
INNER JOIN artist_credit ac ON ac.id = acr.artist_credit_id
LEFT JOIN (
  SELECT
    release_group_alias.release_group_id,
    GROUP_CONCAT(release_group_alias.name, CHAR(9)) AS alias_names,
    GROUP_CONCAT(release_group_alias.locale, CHAR(9)) AS alias_locales
  FROM release_group_alias
  WHERE release_group_alias.is_primary
  GROUP BY release_group_alias.release_group_id
) AS aliases ON aliases.release_group_id = release_group.id
WHERE (
  release_group.name LIKE :query OR
  release_group.disambiguation LIKE :query OR
  release_group.first_release_date LIKE :query OR
  release_group.primary_type LIKE :query OR
  release_group.secondary_types LIKE :query OR
  ac.name LIKE :query OR
  aliases.alias_names LIKE :query
);

getAllReleaseGroups:
WITH
  rec_listens AS (
    SELECT
      recording_musicbrainz_id AS recording_id,
      COUNT(*) AS listen_count,
      MAX(listened_at_ms) AS last_listened_at
    FROM listen
    WHERE username = :username
      AND deleted_at_ms IS NULL
    GROUP BY recording_musicbrainz_id
  ),
  rg_stats AS (
    SELECT
      uniq.release_group_id,
      COALESCE(SUM(rec_listens.listen_count), 0) AS listen_count,
      MAX(rec_listens.last_listened_at) AS last_listened_at
    FROM (
      SELECT DISTINCT
        release_release_group.release_group_id AS release_group_id,
        track.recording_id AS recording_id
      FROM release_release_group
      INNER JOIN release ON release_release_group.release_id = release.id
      INNER JOIN medium ON medium.release_id = release.id
      INNER JOIN track ON track.medium_id = medium.id
    ) AS uniq
    LEFT JOIN rec_listens ON rec_listens.recording_id = uniq.recording_id
    GROUP BY uniq.release_group_id
  )
SELECT
  release_group.id,
  release_group.name,
  release_group.disambiguation,
  release_group.first_release_date,
  release_group.primary_type_id,
  release_group.secondary_type_ids,
  ac.name AS artist_credits,
  images.id AS image_id,
  images.source,
  images.thumbnail_url,
  EXISTS (
    SELECT 1 FROM details_metadata WHERE details_metadata.entity_id = release_group.id
  ) AS visited,
  EXISTS (
    SELECT 1 FROM collection_entity WHERE collection_entity.entity_id = release_group.id
  ) AS collected,
  aliases.alias_names,
  aliases.alias_locales,
  CASE WHEN :username = '' THEN CAST(NULL AS INTEGER) ELSE COALESCE(lg.listen_count, 0) END AS listen_count,
  CASE WHEN :username = '' THEN CAST(NULL AS INTEGER) ELSE lg.last_listened_at END AS last_listened_at
FROM release_group
INNER JOIN artist_credit_entity acr ON acr.entity_id = release_group.id
INNER JOIN artist_credit ac ON ac.id = acr.artist_credit_id
LEFT JOIN rg_stats lg ON lg.release_group_id = release_group.id
LEFT JOIN (
  SELECT
    mbid_image.mbid,
    mbid_image.id,
    mbid_image.source,
    mbid_image.thumbnail_url
  FROM mbid_image
  GROUP BY mbid_image.mbid
  ORDER BY mbid_image.id
) AS images ON images.mbid = release_group.id
LEFT JOIN (
  SELECT
    release_group_alias.release_group_id,
    GROUP_CONCAT(release_group_alias.name, CHAR(9)) AS alias_names,
    GROUP_CONCAT(release_group_alias.locale, CHAR(9)) AS alias_locales
  FROM release_group_alias
  WHERE release_group_alias.is_primary
  GROUP BY release_group_alias.release_group_id
) AS aliases ON aliases.release_group_id = release_group.id
WHERE (
  release_group.name LIKE :query OR
  release_group.disambiguation LIKE :query OR
  release_group.first_release_date LIKE :query OR
  release_group.primary_type LIKE :query OR
  release_group.secondary_types LIKE :query OR
  artist_credits LIKE :query OR
  aliases.alias_names LIKE :query
)
ORDER BY
  CASE :sortBy
    WHEN 0 THEN release_group.rowid
    WHEN 2 THEN release_group.name
    WHEN 4 THEN release_group.first_release_date
    WHEN 6 THEN release_group.primary_type
    WHEN 8 THEN listen_count
    WHEN 10 THEN last_listened_at
  END ASC,
  CASE :sortBy
    WHEN 1 THEN release_group.rowid
    WHEN 3 THEN release_group.name
    WHEN 5 THEN release_group.first_release_date
    WHEN 7 THEN release_group.primary_type
    WHEN 9 THEN listen_count
    WHEN 11 THEN last_listened_at
  END DESC,
  release_group.primary_type ASC,
  release_group.secondary_types ASC,
  release_group.first_release_date ASC
LIMIT :limit OFFSET :offset;
